# Copy to .env.local for local development, or set these in Vercel →
# Project → Settings → Environment Variables. None are required locally.

# Hosted Postgres (Vercel → Storage → Neon sets DATABASE_URL automatically).
# Without it, AdMate uses an embedded database in .data/ (local dev only).
DATABASE_URL=

# Optional: only people with this code can create an account.
ADMATE_INVITE_CODE=

# Optional: analytics (PostHog → Project settings → Project API key).
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (default) or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: AI summaries and Ask AdMate.
ANTHROPIC_API_KEY=
# ADMATE_MODEL=claude-opus-5-5
# ADMATE_ASK_DAILY_LIMIT=40
