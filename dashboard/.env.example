# Copy to .env.local for local development, or set these in Vercel →
# Project → Settings → Environment Variables. None are required locally.

# Hosted Postgres (Vercel → Storage → Neon sets DATABASE_URL automatically).
# Without it, AdMate uses an embedded database in .data/ (local dev only).
DATABASE_URL=

# AdMate integration (INTEGRATION.md): sign-in happens on the website.
# The public origin people use, e.g. https://www.admate.site (local: http://localhost:3000).
ADMATE_PUBLIC_ORIGIN=
# The website's Supabase project (public values; the same project the website signs in with).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The Supabase user id of the owner (owner-only features; the only user admitted unless ADMATE_ACCESS=open).
META_OWNER_USER_ID=
# "open" = open registration (submission MVP). Anything else = owner only.
ADMATE_ACCESS=
# Secret for the public demo refresh endpoint (at least 32 characters). Unset = refresh off.
CRON_SECRET=

# Optional: analytics (PostHog → Project settings → Project token, starts with phc_).
# Public by design; still only sent after the person allows analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US, the default) or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: AI summaries and Ask AdMate.
ANTHROPIC_API_KEY=
# ADMATE_MODEL=claude-opus-5-5
# ADMATE_ASK_DAILY_LIMIT=40
# AdMate Assistant on/off (off unless "true").
# ADMATE_ASK_ENABLED=true
# Credits (lib/ai/credits.ts): what 1 credit is worth in AI usage (US dollars), and the
# one-time free credits per person. 0.0125 × 20 = about $0.25 of AI cost per person.
# ADMATE_CREDIT_USD=0.0125
# ADMATE_FREE_CREDITS=20
# Test checkout for credit packs (no money moves). Local and preview ONLY: with it on,
# anyone signed in can add credits for free. Never set it in Production.
# ADMATE_TEST_PAYMENTS=true

# Optional: "Forgot password?" emails, sent through Resend (resend.com → API Keys).
# Without a key, local development prints the reset link in the terminal instead.
RESEND_API_KEY=
# Sender, e.g. "AdMate <hello@yourdomain.com>" once your domain is verified in Resend.
# Until then Resend's test sender only delivers to your own Resend account's email.
# ADMATE_EMAIL_FROM=AdMate <onboarding@resend.dev>

# Optional: "Continue with Google" (Google Cloud → APIs & Services → Credentials →
# OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the site's own address for links and Google's return address. On Vercel
# it's worked out automatically; locally it's http://localhost:3000.
# ADMATE_SITE_URL=https://admate-alpha.vercel.app

# TikTok for Business connection (testing only; off unless enabled). Read-only.
# TIKTOK_CONNECT_ENABLED=true
# Comma-separated Supabase user IDs allowed to connect (empty = nobody).
# TIKTOK_CONNECT_ALLOWED_USER_IDS=
# Public client ID from TikTok's MCP client registration (one per environment).
# TIKTOK_MCP_CLIENT_ID=
# https://business-api.tiktok.com/open_mcp/tt-ads-mcp-layer (default) or .../tt-ads-mcp-flat
# TIKTOK_MCP_SERVER=
# Base64 of 32 random bytes, server-only secret: openssl rand -base64 32
# TIKTOK_CONNECT_ENCRYPTION_KEY=
